{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n\nimport AppLayout from './components/AppLayout.vue';\nimport Login from './views/Login.vue';\nexport default {\n  name: 'AppRoot',\n  components: {\n    AppLayout: AppLayout,\n    Login: Login\n  },\n  computed: {\n    showLayout: function showLayout() {\n      return this.$route.path !== '/login' && localStorage.getItem('token');\n    }\n  }\n};","map":{"version":3,"names":["AppLayout","Login","name","components","computed","showLayout","$route","path","localStorage","getItem"],"sources":["src/App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <AppLayout v-if=\"showLayout\" />\n    <Login v-else />\n  </div>\n</template>\n\n<script>\nimport AppLayout from './components/AppLayout.vue';\nimport Login from './views/Login.vue';\n\nexport default {\n  name: 'AppRoot',\n  components: { AppLayout, Login },\n  computed: {\n    showLayout() {\n      return this.$route.path !== '/login' && localStorage.getItem('token');\n    }\n  }\n};\n</script>\n\n<style>\n#app {\n  width: 100%;\n  height: 100%;\n}\n</style>\n"],"mappings":";;;;;;;;AAQA,OAAAA,SAAA;AACA,OAAAC,KAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAH,SAAA,EAAAA,SAAA;IAAAC,KAAA,EAAAA;EAAA;EACAG,QAAA;IACAC,UAAA,WAAAA,WAAA;MACA,YAAAC,MAAA,CAAAC,IAAA,iBAAAC,YAAA,CAAAC,OAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}